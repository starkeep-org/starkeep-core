{
  "name": "@starkeep/app-client",
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./load-env": {
      "types": "./dist/load-env-auto.d.ts",
      "import": "./dist/load-env-auto.js",
      "require": "./dist/load-env-auto.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "require": "./dist/edge.cjs"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "import": "./dist/lambda.js",
      "require": "./dist/lambda.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starkeep-org/starkeep-core.git",
    "directory": "packages/app-client"
  },
  "homepage": "https://github.com/starkeep-org/starkeep-core/tree/main/packages/app-client",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.700.0",
    "dotenv": "^17.4.2"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@types/node": "^25.4.0",
    "aws-sdk-client-mock": "^4.1.0",
    "hono": "^4.13.5",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
