{
  "name": "@starkeep/data-protocol",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-pnpm-on-path.mjs",
    "postinstall": "turbo run build",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:aws": "turbo run test:aws",
    "test:aws:custom-domain": "turbo run test:aws:custom-domain",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "node scripts/sync-plugin-ref.mjs && prettier --write .",
    "format:check": "prettier --check .",
    "icons": "tsx scripts/icons.ts",
    "check:icons": "tsx scripts/icons.ts --check",
    "changeset": "changeset",
    "release:publish": "bash scripts/release-publish.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ],
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@smithy/smithy-client": "4.12.12",
      "@smithy/types": "4.14.2",
      "@grpc/grpc-js": "^1.14.5",
      "@hono/node-server": "^2.0.5",
      "body-parser": "^2.4.0",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@5": "^5.0.11",
      "fast-uri": "^3.1.7",
      "fast-xml-builder": "^1.1.7",
      "flatted": "^3.4.2",
      "hono": "^4.12.25",
      "protobufjs": "^7.6.1",
      "sharp": "^0.35.3",
      "sigstore": "^4.1.1",
      "tmp": "^0.2.6",
      "undici@6": "^6.29.1",
      "vite": "^8.3.5",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.1",
      "fast-xml-parser": "^5.7.0",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "picomatch@4": "^4.0.4",
      "postcss": "^8.5.18",
      "qs": "^6.15.2",
      "tar@7": "^7.5.21",
      "pacote": "^21.5.1",
      "ip-address": "^10.3.1",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "proxy-addr": "^2.0.8",
      "@modelcontextprotocol/sdk": "^1.32.0"
    }
  }
}
