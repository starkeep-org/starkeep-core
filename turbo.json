{
  "$schema": "https://turbo.build/schema.json",
  // Persisted `lint` and `typecheck` hits must not survive a change to the
  // root config every package extends.
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Test tasks never replay from cache: CI persists `.turbo/cache`, and a
    // test's hash misses inputs it reads from other packages (admin-installer's
    // tests read cloud-data-server's `dist.zip`). A `pkg#test` entry replaces
    // this definition rather than inheriting it, so each one repeats it.
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "admin-web#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@starkeep/drive#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@starkeep/builtin-cloud-data-server#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // Integration tests (`__tests__/integration/`) boot a process, a socket or
    // a database engine; they run apart from the unit tests, outside tier 1.
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "admin-web#test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@starkeep/builtin-cloud-data-server#test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      // admin-web's and Drive's clients are real builds now rather than
      // something compiled on demand, so the tier-2 stack needs `dist/` present
      // before it boots the servers that serve them.
      "dependsOn": ["^build", "admin-web#build", "@starkeep/drive#build"],
      "cache": false
    },
    "admin-web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@starkeep/drive#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Its build writes a Lambda bundle, `dist.zip`, not `dist/`.
    "@starkeep/builtin-cloud-data-server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist.zip"]
    },
    "test:aws": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "STARKEEP_AWS_TESTS",
        "STARKEEP_AWS_APP_DIR",
        "STARKEEP_AWS_STACK_PREFIX",
        "STARKEEP_AWS_REGION",
        "STARKEEP_AWS_TEARDOWN",
        "AWS_PROFILE",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_CONFIG_FILE"
      ]
    },
    // The live custom-domain suite: optional, and apart from `test:aws`, so a
    // journey run never needs a DNS zone. Only e2e-aws-custom-domain defines it.
    "test:aws:custom-domain": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "STARKEEP_AWS_TESTS",
        "STARKEEP_AWS_CUSTOM_DOMAIN_ZONE",
        "STARKEEP_AWS_STACK_PREFIX",
        "STARKEEP_AWS_REGION",
        "STARKEEP_AWS_TEARDOWN",
        "STARKEEP_DIR",
        "AWS_PROFILE",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_CONFIG_FILE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
