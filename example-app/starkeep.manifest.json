{
  "id": "example-app",
  "name": "Example App",
  "version": "0.1.0",
  "protocolMinVersion": "1.1.0",
  "description": "Performs every app-facing data operation on invented plaintext files, and shows each request and its result. Safe to run on a real deployment: it reads and writes only its own example type.",
  "tier": "official",
  "targets": ["local", "cloud"],
  "localRun": {
    "command": "pnpm",
    "args": ["start"],
    "cwd": "web",
    "portFlag": "--port"
  },
  "infraRequirements": {
    "fileAccess": [
      {
        "types": ["example/plaintext"],
        "access": "readwrite",
        "metadataWrite": true,
        "rationale": "The example app creates, reads, labels and deletes invented plaintext files of its own type, and writes their line, word and character counts. It never reads or writes any other type."
      }
    ],
    "labelKeys": [
      {
        "key": "tag",
        "description": "A set-valued tag on an example file, such as draft or idea."
      },
      {
        "key": "reviewed",
        "description": "A bare flag: the example file has been reviewed."
      },
      {
        "key": "derived",
        "description": "Marks a derived copy, valued with how the copy was made, such as uppercase."
      },
      {
        "key": "sample",
        "description": "A bare flag: the example app's Load sample data button made this file."
      },
      {
        "key": "keyword",
        "description": "A set-valued keyword the example app's keywords job found in an example file's text, such as flour."
      },
      {
        "key": "indexed",
        "description": "A bare flag: the example app's keywords job has read this example file."
      }
    ],
    "appSpecificSyncable": {
      "files": true,
      "tables": [
        {
          "name": "notes",
          "columns": [
            { "name": "record_id", "type": "text", "primaryKey": true, "notNull": true },
            { "name": "note", "type": "text" },
            { "name": "pinned", "type": "boolean" },
            { "name": "updated_on", "type": "timestamp" }
          ],
          "indexes": [{ "columns": ["pinned"] }]
        },
        {
          "name": "collections",
          "columns": [
            { "name": "id", "type": "text", "primaryKey": true, "notNull": true },
            { "name": "name", "type": "text", "notNull": true },
            { "name": "archived", "type": "boolean" },
            { "name": "created_on", "type": "timestamp" }
          ]
        },
        {
          "name": "collection_items",
          "columns": [
            { "name": "collection_id", "type": "text", "primaryKey": true, "notNull": true },
            { "name": "record_id", "type": "text", "primaryKey": true, "notNull": true },
            { "name": "added_on", "type": "timestamp" }
          ],
          "indexes": [{ "columns": ["record_id"] }]
        }
      ]
    },
    "publicSharing": true,
    "jobs": [
      {
        "name": "digest",
        "handler": "static",
        "mode": "readwrite",
        "defaultTime": "07:00",
        "description": "Writes a digest of your example files and notes as a new example file, and rotates the provider token you stored in the vault."
      },
      {
        "name": "keywords",
        "handler": "static",
        "mode": "read",
        "defaultTime": null,
        "description": "Reads each new example file and labels it with up to three keywords from its text. It writes labels only."
      }
    ],
    "compute": {
      "enabled": true,
      "handlers": [
        {
          "name": "static",
          "handler": "index.handler",
          "memoryMb": 256,
          "timeoutSeconds": 10,
          "routes": ["GET /", "ANY /{proxy+}", { "route": "POST /mcp", "auth": "delegated" }],
          "auth": "session",
          "publicPaths": [
            "/",
            "/_immutable/*",
            "/sign-in",
            "/api/session/*",
            "/starkeep-runtime-config"
          ],
          "staticAssetPaths": ["/", "/_immutable/*"],
          "bundleAssetsDir": "assets",
          "env": {
            "STARKEEP_API_GATEWAY_URL": "",
            "STARKEEP_USER_POOL_ID": "",
            "STARKEEP_USER_POOL_CLIENT_ID": "",
            "STARKEEP_IDENTITY_POOL_ID": ""
          }
        },
        {
          "name": "api",
          "handler": "api.handler",
          "memoryMb": 256,
          "timeoutSeconds": 10,
          "routes": ["POST /api/echo"]
        }
      ]
    }
  }
}
